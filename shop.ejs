<%- include('partials/navbar', { user, cartCount }) %>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Shop</h1>
      <p class="text-gray-500 mt-1">
        <% if (searchQuery) { %>Results for "<strong class="text-gray-700"><%= searchQuery %></strong>"<% } else { %>Browse all our products<% } %>
      </p>
    </div>
    <div class="flex items-center gap-3 flex-wrap">
      <!-- Category Filter -->
      <form action="/search" method="GET" class="flex items-center gap-2">
        <% if (searchQuery) { %><input type="hidden" name="q" value="<%= searchQuery %>"><% } %>
        <select name="category" onchange="this.form.submit()" class="input-field h-10 rounded-xl border border-gray-200 px-3 pr-8 text-sm bg-white outline-none cursor-pointer appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2012%2012%22%3E%3Cpath%20fill%3D%22%236b7280%22%20d%3D%22M6%208L1%203h10z%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_10px_center] bg-no-repeat">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= selectedCategory === cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        </select>
      </form>
      <!-- Search -->
      <form action="/search" method="GET" class="flex items-center">
        <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>
        <div class="relative flex items-center">
          <i class="fas fa-search absolute left-3 text-gray-400 text-xs pointer-events-none"></i>
          <input type="text" name="q" value="<%= searchQuery %>" placeholder="Search..." class="input-field h-10 w-40 sm:w-48 rounded-xl border border-gray-200 pl-9 pr-3 text-sm outline-none bg-white">
        </div>
      </form>
    </div>
  </div>

  <!-- Category Quick Filters -->
  <div class="flex gap-2 mb-8 overflow-x-auto pb-2 scrollbar-hide">
    <a href="/shop" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition
      <%= !selectedCategory ? 'bg-brand-600 text-white border-brand-600' : 'bg-white text-gray-600 border-gray-200 hover:border-brand-300 hover:text-brand-700' %>">
      <i class="fas fa-th text-xs"></i> All
    </a>
    <% categories.forEach(cat => { %>
      <a href="/search?category=<%= cat.id %>" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium border transition
        <%= selectedCategory === cat.id ? 'bg-brand-600 text-white border-brand-600' : 'bg-white text-gray-600 border-gray-200 hover:border-brand-300 hover:text-brand-700' %>">
        <span class="text-xs"><%= getCategoryEmoji(cat.name) %></span> <%= cat.name %>
      </a>
    <% }); %>
  </div>

  <!-- Products Grid -->
  <% if (products.length === 0) { %>
    <div class="py-24 text-center">
      <div class="mx-auto mb-5 flex h-24 w-24 items-center justify-center rounded-full bg-gray-100">
        <i class="fas fa-search text-4xl text-gray-300"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900">No products found</h2>
      <p class="text-gray-500 mt-2 max-w-sm mx-auto">We couldn't find any products matching your search. Try adjusting your filters.</p>
      <a href="/shop" class="inline-flex items-center gap-2 mt-6 rounded-xl btn-primary text-white font-semibold px-6 py-3">
        <i class="fas fa-arrow-left text-xs"></i> Back to Shop
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
      <% products.forEach((p, i) => { %>
        <div class="product-card rounded-2xl bg-white border border-gray-100 overflow-hidden group">
          <a href="/product/<%= p.id %>">
            <div class="aspect-square bg-gradient-to-br <%= getCategoryGradient(p.category_name) %> flex items-center justify-center relative overflow-hidden">
              <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"><% } else { %><span class="text-5xl sm:text-6xl group-hover:scale-110 transition-transform duration-500 drop-shadow-lg"><%= getProductEmoji(p.name) %></span><% } %>
              <% if (p.featured) { %>
                <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[10px] font-semibold text-amber-700 px-2 py-0.5 rounded-lg shadow-sm">
                  <i class="fas fa-star text-amber-500 mr-0.5"></i> Featured
                </span>
              <% } %>
              <% if (p.stock <= 5 && p.stock > 0) { %>
                <span class="absolute top-3 right-3 bg-red-500/90 backdrop-blur-sm text-[10px] font-semibold text-white px-2 py-0.5 rounded-lg">Only <%= p.stock %> left</span>
              <% } %>
            </div>
          </a>
          <div class="p-4">
            <p class="text-[11px] text-brand-600 font-semibold uppercase tracking-wider mb-1"><%= p.category_name %></p>
            <a href="/product/<%= p.id %>">
              <h3 class="font-semibold text-gray-900 line-clamp-2 hover:text-brand-700 transition text-sm sm:text-base leading-snug"><%= p.name %></h3>
            </a>
            <div class="mt-2.5 flex items-baseline gap-2">
              <span class="text-lg font-bold text-gray-900">$<%= parseFloat(p.price).toFixed(2) %></span>
              <span class="text-xs text-gray-400 font-medium">/ <%= p.unit %></span>
            </div>
            <% if (p.stock > 0) { %>
              <form action="/cart/add/<%= p.id %>" method="POST" class="mt-3">
                <button type="submit" class="w-full rounded-xl btn-primary text-white text-sm font-semibold py-2.5 flex items-center justify-center gap-1.5">
                  <i class="fas fa-cart-plus text-xs"></i> Add to Cart
                </button>
              </form>
            <% } else { %>
              <div class="mt-3 text-center py-2.5 rounded-xl bg-gray-100 text-sm font-semibold text-gray-400">Out of Stock</div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
    <p class="text-center text-sm text-gray-400 mt-8"><%= products.length %> product<%= products.length !== 1 ? 's' : '' %> found</p>
  <% } %>
</section>

<%- include('partials/footer') %>
