<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - FreshMart' : 'FreshMart - Your Online Grocery Store' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50:'#f0fdf4',100:'#dcfce7',200:'#bbf7d0',300:'#86efac',400:'#4ade80',500:'#22c55e',600:'#16a34a',700:'#15803d',800:'#166534',900:'#14532d' },
            accent: { 400:'#fb923c',500:'#f97316',600:'#ea580c' }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    * { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .line-clamp-2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    @keyframes fadeIn{from{opacity:0}to{opacity:1}}
    @keyframes fadeOut{from{opacity:1}to{opacity:0;transform:translateY(-10px)}}
    @keyframes slideIn{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:translateX(0)}}
    @keyframes pulse-soft{0%,100%{opacity:1}50%{opacity:.7}}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
    @keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
    .toast-enter{animation:fadeInUp .4s cubic-bezier(.16,1,.3,1)}
    .toast-exit{animation:fadeOut .3s ease forwards}
    .animate-fadeInUp{animation:fadeInUp .6s cubic-bezier(.16,1,.3,1) both}
    .animate-fadeIn{animation:fadeIn .5s ease both}
    .animate-float{animation:float 3s ease-in-out infinite}
    .animate-slideIn{animation:slideIn .4s ease both}
    .delay-100{animation-delay:.1s}
    .delay-200{animation-delay:.2s}
    .delay-300{animation-delay:.3s}
    .delay-400{animation-delay:.4s}
    .delay-500{animation-delay:.5s}
    .glass{background:rgba(255,255,255,.8);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
    .glass-dark{background:rgba(0,0,0,.5);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
    .gradient-text{background:linear-gradient(135deg,#16a34a,#059669,#0d9488);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .product-card{transition:all .3s cubic-bezier(.16,1,.3,1)}
    .product-card:hover{transform:translateY(-6px);box-shadow:0 20px 40px -12px rgba(0,0,0,.15)}
    .category-card{transition:all .3s cubic-bezier(.16,1,.3,1)}
    .category-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px -8px rgba(0,0,0,.1)}
    .btn-primary{background:linear-gradient(135deg,#16a34a,#059669);transition:all .3s ease}
    .btn-primary:hover{background:linear-gradient(135deg,#15803d,#047857);transform:translateY(-1px);box-shadow:0 8px 20px -4px rgba(22,163,74,.4)}
    .btn-accent{background:linear-gradient(135deg,#f97316,#ea580c);transition:all .3s ease}
    .btn-accent:hover{background:linear-gradient(135deg,#ea580c,#c2410c);transform:translateY(-1px);box-shadow:0 8px 20px -4px rgba(249,115,22,.4)}
    .hero-pattern{background-image:radial-gradient(circle at 20% 50%,rgba(255,255,255,.1) 0%,transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,255,255,.08) 0%,transparent 50%),radial-gradient(circle at 40% 80%,rgba(255,255,255,.05) 0%,transparent 50%)}
    .input-field{transition:all .2s ease}
    .input-field:focus{border-color:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,.1)}
    .stat-card{transition:all .3s ease}
    .stat-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px -8px rgba(0,0,0,.1)}
    ::selection{background-color:#dcfce7;color:#14532d}
    ::-webkit-scrollbar{width:8px}
    ::-webkit-scrollbar-track{background:#f1f5f9}
    ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
    ::-webkit-scrollbar-thumb:hover{background:#94a3b8}
  </style>
</head>
<body class="bg-slate-50 text-gray-900 antialiased">
