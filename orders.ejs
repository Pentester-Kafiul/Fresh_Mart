<%- include('partials/navbar', { user, cartCount }) %>

<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-1">My Orders</h1>
  <p class="text-gray-500 mb-8">View and track your order history</p>

  <% if (orders.length === 0) { %>
    <div class="py-24 text-center">
      <div class="mx-auto mb-5 flex h-28 w-28 items-center justify-center rounded-full bg-gray-100">
        <i class="fas fa-clipboard-list text-5xl text-gray-300"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900">No orders yet</h2>
      <p class="text-gray-500 mt-2 max-w-sm mx-auto">Your order history will appear here once you make a purchase.</p>
      <a href="/shop" class="inline-flex items-center gap-2 mt-8 rounded-xl btn-primary text-white font-semibold px-8 py-3.5 shadow-lg shadow-brand-500/25">
        <i class="fas fa-shopping-bag text-sm"></i> Start Shopping
      </a>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% orders.forEach(order => { %>
        <div class="rounded-2xl border border-gray-100 bg-white overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-5 sm:p-6">
            <!-- Order Header -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
              <div>
                <h3 class="font-bold text-gray-900 text-lg">Order #<%= order.id %></h3>
                <p class="text-sm text-gray-400 mt-0.5">
                  <i class="fas fa-calendar text-xs mr-1"></i>
                  <%= new Date(order.created_at).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                </p>
              </div>
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold
                  <% if (order.status === 'pending') { %>bg-amber-50 text-amber-700 border border-amber-200<% }
                  else if (order.status === 'confirmed') { %>bg-blue-50 text-blue-700 border border-blue-200<% }
                  else if (order.status === 'delivered') { %>bg-emerald-50 text-emerald-700 border border-emerald-200<% }
                  else { %>bg-red-50 text-red-600 border border-red-200<% } %>">
                  <i class="fas
                    <% if (order.status === 'pending') { %>fa-clock<% }
                    else if (order.status === 'confirmed') { %>fa-check-circle<% }
                    else if (order.status === 'delivered') { %>fa-truck<% }
                    else { %>fa-circle-xmark<% } %> text-[10px]"></i>
                  <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                </span>
                <span class="text-lg font-extrabold text-gray-900">$<%= parseFloat(order.total).toFixed(2) %></span>
              </div>
            </div>

            <!-- Payment details -->
            <% if (order.payment_method === 'bkash' || order.payment_method === 'nagad') { %>
              <div class="mt-4 rounded-xl border border-gray-100 p-3 text-sm">
                <div class="flex flex-wrap justify-between gap-2">
                  <span class="text-gray-500">Payment method</span>
                  <strong class="text-gray-800"><%= order.payment_method.toUpperCase() %></strong>
                </div>
                <% if (order.transaction_id) { %>
                  <div class="flex flex-wrap justify-between gap-2 mt-2">
                    <span class="text-gray-500">Transaction ID</span>
                    <span class="font-mono text-gray-700"><%= order.transaction_id %></span>
                  </div>
                <% } %>
                <div class="flex flex-wrap justify-between gap-2 mt-2">
                  <span class="text-gray-500">Payment verification</span>
                  <strong class="<%= order.payment_status === 'paid' ? 'text-emerald-700' : order.payment_status === 'rejected' ? 'text-red-600' : 'text-amber-700' %>"><%= (order.payment_status || 'unverified').toUpperCase() %></strong>
                </div>
              </div>
            <% } %>

            <!-- Order Items -->
            <div class="bg-gray-50 rounded-xl p-3 space-y-2">
              <% order.items.forEach(item => { %>
                <div class="flex items-center gap-3 text-sm py-1">
                  <div class="h-9 w-9 rounded-lg bg-gradient-to-br from-emerald-100 to-teal-100 flex items-center justify-center flex-shrink-0 text-lg">
                    <%= getProductEmoji(item.product_name) %>
                  </div>
                  <span class="flex-1 text-gray-700 font-medium truncate"><%= item.product_name %></span>
                  <span class="text-gray-400 text-xs">x<%= item.quantity %></span>
                  <span class="font-semibold text-gray-900">$<%= (item.price * item.quantity).toFixed(2) %></span>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
