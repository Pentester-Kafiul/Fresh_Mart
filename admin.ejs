<%- include('partials/navbar', { user, cartCount }) %>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center text-white text-sm">
          <i class="fas fa-shield-halved"></i>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
      </div>
      <p class="text-gray-500 text-sm">Manage your store products and orders</p>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stat-card rounded-2xl bg-white border border-gray-100 p-5 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/20">
          <i class="fas fa-box text-sm"></i>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900"><%= stats.productCount %></p>
          <p class="text-xs text-gray-500 font-medium">Products</p>
        </div>
      </div>
    </div>
    <div class="stat-card rounded-2xl bg-white border border-gray-100 p-5 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/20">
          <i class="fas fa-receipt text-sm"></i>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900"><%= stats.total_orders %></p>
          <p class="text-xs text-gray-500 font-medium">Orders</p>
        </div>
      </div>
    </div>
    <div class="stat-card rounded-2xl bg-white border border-gray-100 p-5 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20">
          <i class="fas fa-dollar-sign text-sm"></i>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900">$<%= parseFloat(stats.total_revenue).toFixed(0) %></p>
          <p class="text-xs text-gray-500 font-medium">Revenue</p>
        </div>
      </div>
    </div>
    <div class="stat-card rounded-2xl bg-white border border-gray-100 p-5 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-br from-amber-400 to-orange-600 flex items-center justify-center text-white shadow-lg shadow-amber-500/20">
          <i class="fas fa-users text-sm"></i>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900"><%= stats.total_customers %></p>
          <p class="text-xs text-gray-500 font-medium">Customers</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="flex gap-1 mb-6 bg-gray-100 rounded-xl p-1 w-fit">
    <button onclick="showTab('products')" id="tab-products" class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-white shadow-sm text-gray-900 transition">
      <i class="fas fa-box mr-1.5 text-xs"></i> Products
    </button>
    <button onclick="showTab('orders')" id="tab-orders" class="px-5 py-2.5 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-700 transition">
      <i class="fas fa-shopping-bag mr-1.5 text-xs"></i> Orders
    </button>
  </div>

  <!-- ═══ Products Tab ═══ -->
  <div id="panel-products">
    <!-- Edit Product Form -->
    <% if (typeof editProduct !== 'undefined' && editProduct) { %>
    <div class="rounded-2xl border-2 border-blue-200 bg-blue-50/40 p-6 mb-6">
      <div class="flex items-center justify-between mb-5">
        <h3 class="font-bold text-gray-900 flex items-center gap-2">
          <div class="h-7 w-7 rounded-lg bg-blue-100 flex items-center justify-center">
            <i class="fas fa-pen text-blue-600 text-xs"></i>
          </div>
          Edit Product: <%= editProduct.name %>
        </h3>
        <a href="/admin" class="text-gray-400 hover:text-gray-600 transition"><i class="fas fa-xmark"></i></a>
      </div>
      <form action="/admin/products/edit/<%= editProduct.id %>" method="POST" enctype="multipart/form-data">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Name *</label>
            <input type="text" name="name" value="<%= editProduct.name %>" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Slug</label>
            <input type="text" name="slug" value="<%= editProduct.slug %>" placeholder="auto-generated" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Price *</label>
            <input type="number" step="0.01" name="price" value="<%= editProduct.price %>" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Stock</label>
            <input type="number" name="stock" value="<%= editProduct.stock %>" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Unit</label>
            <select name="unit" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm bg-white outline-none">
              <option value="piece" <%= editProduct.unit === 'piece' ? 'selected' : '' %>>piece</option>
              <option value="kg" <%= editProduct.unit === 'kg' ? 'selected' : '' %>>kg</option>
              <option value="liter" <%= editProduct.unit === 'liter' ? 'selected' : '' %>>liter</option>
              <option value="pack" <%= editProduct.unit === 'pack' ? 'selected' : '' %>>pack</option>
              <option value="dozen" <%= editProduct.unit === 'dozen' ? 'selected' : '' %>>dozen</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Category *</label>
            <select name="categoryId" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm bg-white outline-none">
              <% categories.forEach(cat => { %><option value="<%= cat.id %>" <%= editProduct.category_id === cat.id ? 'selected' : '' %>><%= cat.name %></option><% }); %>
            </select>
          </div>
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Description</label>
            <textarea name="description" rows="2" class="input-field w-full rounded-xl border border-gray-200 px-3 py-2 text-sm outline-none"><%= editProduct.description || '' %></textarea>
          </div>
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Photo (optional)</label>
            <% if (editProduct.image) { %><img src="<%= editProduct.image %>" alt="<%= editProduct.name %>" class="h-24 w-24 object-cover rounded-xl mb-2"><% } %>
            <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full text-sm text-gray-600">
            <p class="text-xs text-gray-400 mt-1">JPG, PNG, WEBP or GIF. Maximum 5 MB. Leave empty to keep the current photo.</p>
          </div>
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="featured" value="true" <%= editProduct.featured ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
              <span class="text-sm font-medium text-gray-700">Featured product</span>
            </label>
          </div>
        </div>
        <div class="mt-5 flex gap-3">
          <button type="submit" class="rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold px-6 py-2.5 shadow-lg shadow-blue-500/20 hover:shadow-xl transition">
            <i class="fas fa-save mr-1.5 text-sm"></i> Save Changes
          </button>
          <a href="/admin" class="rounded-xl border border-gray-200 text-gray-600 font-medium px-6 py-2.5 hover:bg-gray-50 transition">Cancel</a>
        </div>
      </form>
    </div>
    <% } %>

    <!-- Add Product Button -->
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold text-gray-900">Products (<%= products.length %>)</h2>
      <button onclick="document.getElementById('add-form').classList.toggle('hidden')" class="rounded-xl btn-primary text-white font-semibold px-5 py-2.5 text-sm shadow-lg shadow-brand-500/20">
        <i class="fas fa-plus mr-1.5 text-xs"></i> Add Product
      </button>
    </div>

    <!-- Add Product Form -->
    <div id="add-form" class="hidden rounded-2xl border border-gray-100 bg-white p-6 mb-6 shadow-sm">
      <h3 class="font-bold text-gray-900 mb-5 flex items-center gap-2">
        <div class="h-7 w-7 rounded-lg bg-brand-50 flex items-center justify-center">
          <i class="fas fa-plus-circle text-brand-600 text-xs"></i>
        </div>
        Add New Product
      </h3>
      <form action="/admin/products/add" method="POST" enctype="multipart/form-data">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Name *</label><input type="text" name="name" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none" placeholder="Product name"></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Slug</label><input type="text" name="slug" placeholder="auto-generated" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none"></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Price *</label><input type="number" step="0.01" name="price" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none" placeholder="0.00"></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Stock</label><input type="number" name="stock" value="100" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm outline-none"></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Unit</label><select name="unit" class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm bg-white outline-none"><option value="piece">piece</option><option value="kg">kg</option><option value="liter">liter</option><option value="pack">pack</option><option value="dozen">dozen</option></select></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1.5">Category *</label><select name="categoryId" required class="input-field w-full h-10 rounded-xl border border-gray-200 px-3 text-sm bg-white outline-none"><option value="">Select...</option><% categories.forEach(cat => { %><option value="<%= cat.id %>"><%= cat.name %></option><% }); %></select></div>
          <div class="sm:col-span-2 lg:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1.5">Description</label><textarea name="description" rows="2" class="input-field w-full rounded-xl border border-gray-200 px-3 py-2 text-sm outline-none" placeholder="Product description..."></textarea></div>
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Product Photo (optional)</label>
            <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" class="block w-full text-sm text-gray-600">
            <p class="text-xs text-gray-400 mt-1">JPG, PNG, WEBP or GIF. Maximum 5 MB.</p>
          </div>
          <div class="flex items-end"><label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="featured" value="true" class="h-4 w-4 rounded border-gray-300 text-brand-600"><span class="text-sm font-medium text-gray-700">Featured</span></label></div>
        </div>
        <button type="submit" class="mt-5 rounded-xl btn-primary text-white font-semibold px-6 py-2.5 shadow-lg shadow-brand-500/20">
          <i class="fas fa-plus mr-1.5 text-xs"></i> Create Product
        </button>
      </form>
    </div>

    <!-- Products Table -->
    <div class="rounded-2xl border border-gray-100 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Product</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider hidden sm:table-cell">Category</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Price</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider hidden sm:table-cell">Stock</th>
              <th class="text-center px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider hidden md:table-cell">Featured</th>
              <th class="text-right px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
            <tr class="border-b last:border-0 hover:bg-gray-50/50 transition-colors">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <% if (p.image) { %>
                    <img src="<%= p.image %>" alt="<%= p.name %>" class="h-10 w-10 rounded-lg object-cover flex-shrink-0">
                  <% } else { %>
                    <div class="h-10 w-10 rounded-lg bg-gradient-to-br from-brand-100 to-teal-100 flex items-center justify-center text-lg flex-shrink-0"><i class="fas fa-box text-brand-400 text-xs"></i></div>
                  <% } %>
                  <div>
                    <p class="font-semibold text-gray-900"><%= p.name %></p>
                    <p class="text-xs text-gray-400 sm:hidden"><%= p.category_name %></p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3.5 text-gray-500 hidden sm:table-cell"><%= p.category_name %></td>
              <td class="px-5 py-3.5 font-bold text-brand-700">$<%= parseFloat(p.price).toFixed(2) %></td>
              <td class="px-5 py-3.5 hidden sm:table-cell">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold
                  <% if (p.stock > 10) { %>bg-emerald-50 text-emerald-600<% }
                  else if (p.stock > 0) { %>bg-amber-50 text-amber-600<% }
                  else { %>bg-red-50 text-red-500<% } %>">
                  <%= p.stock %>
                </span>
              </td>
              <td class="px-5 py-3.5 text-center hidden md:table-cell">
                <% if (p.featured) { %><i class="fas fa-star text-amber-400"></i><% } else { %><span class="text-gray-300">—</span><% } %>
              </td>
             
              <td class="px-5 py-3.5 text-right">
                <div class="flex justify-end gap-1">
                  <a href="/admin/products/edit/<%= p.id %>" class="h-8 w-8 rounded-lg inline-flex items-center justify-center text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition" title="Edit">
                    <i class="fas fa-pen text-xs"></i>
                  </a>
                  <form action="/admin/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete &quot;<%= p.name %>&quot;?')">
                    <button type="submit" class="h-8 w-8 rounded-lg inline-flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition" title="Delete">
                      <i class="fas fa-trash-can text-xs"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══ Orders Tab ═══ -->
  <div id="panel-orders" class="hidden">
    <h2 class="text-lg font-bold text-gray-900 mb-5">Recent Orders (<%= orders.length %>)</h2>
    <% if (orders.length === 0) { %>
      <div class="py-20 text-center rounded-2xl bg-white border border-gray-100">
        <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100">
          <i class="fas fa-inbox text-3xl text-gray-300"></i>
        </div>
        <p class="text-gray-500 font-medium">No orders yet</p>
        <p class="text-gray-400 text-sm mt-1">Orders will appear here when customers make purchases</p>
      </div>
    <% } else { %>
    <div class="rounded-2xl border border-gray-100 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Order</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Customer</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider hidden sm:table-cell">Date</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Total</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Status</th>
              <th class="text-left px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Payment</th>
              <th class="text-right px-5 py-3.5 font-semibold text-gray-500 text-xs uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
            <tr class="border-b last:border-0 hover:bg-gray-50/50 transition-colors">
              <td class="px-5 py-3.5 font-bold text-gray-900">#<%= order.id %></td>
              <td class="px-5 py-3.5">
                <span class="text-gray-700 font-medium"><%= order.customer_name %></span>
                <span class="block text-xs text-gray-400"><%= order.item_count %> item<%= order.item_count !== 1 ? 's' : '' %></span>
              </td>
              <td class="px-5 py-3.5 text-gray-500 hidden sm:table-cell"><%= new Date(order.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
              <td class="px-5 py-3.5 font-bold text-brand-700">$<%= parseFloat(order.total).toFixed(2) %></td>
              <td class="px-5 py-3.5">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold
                  <% if (order.status === 'pending') { %>bg-amber-50 text-amber-700 border border-amber-200<% }
                  else if (order.status === 'confirmed') { %>bg-blue-50 text-blue-700 border border-blue-200<% }
                  else if (order.status === 'delivered') { %>bg-emerald-50 text-emerald-700 border border-emerald-200<% }
                  else { %>bg-red-50 text-red-600 border border-red-200<% } %>">
                  <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                </span>
              </td>
              <td class="px-5 py-3.5">
                <div class="font-semibold text-gray-800"><%= order.payment_method ? order.payment_method.toUpperCase() : 'Not recorded' %></div>
                <% if (order.transaction_id) { %>
                  <div class="text-xs text-gray-500 mt-1">Txn: <span class="font-mono"><%= order.transaction_id %></span></div>
                <% } %>
                <div class="text-xs mt-1 <%= order.payment_status === 'paid' ? 'text-emerald-700' : order.payment_status === 'rejected' ? 'text-red-600' : 'text-amber-700' %>">
                  Payment: <%= (order.payment_status || 'unverified').toUpperCase() %>
                </div>
                <% if (order.payment_method === 'bkash' || order.payment_method === 'nagad') { %>
                  <% if (order.payment_status !== 'paid') { %>
                    <form action="/admin/orders/<%= order.id %>/payment-status" method="POST" class="mt-2 flex flex-wrap gap-1">
                      <button type="submit" name="paymentStatus" value="paid" class="px-2 py-1 rounded bg-emerald-50 text-emerald-700 text-xs font-semibold hover:bg-emerald-100" onclick="return confirm('Have you verified this transaction in the payment app?')">Verify & Mark Paid</button>
                      <button type="submit" name="paymentStatus" value="rejected" class="px-2 py-1 rounded bg-red-50 text-red-600 text-xs font-semibold hover:bg-red-100" onclick="return confirm('Mark this payment as rejected?')">Reject</button>
                    </form>
                  <% } %>
                <% } %>
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="flex justify-end gap-1">
                  <% if (order.status === 'pending') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST">
                    <input type="hidden" name="status" value="confirmed">
                    <button type="submit" class="h-8 w-8 rounded-lg inline-flex items-center justify-center text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition" title="Confirm">
                      <i class="fas fa-check text-xs"></i>
                    </button>
                  </form>
                  <% } %>
                  <% if (order.status === 'confirmed') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST">
                    <input type="hidden" name="status" value="delivered">
                    <button type="submit" class="h-8 w-8 rounded-lg inline-flex items-center justify-center text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 transition" title="Mark Delivered">
                      <i class="fas fa-truck text-xs"></i>
                    </button>
                  </form>
                  <% } %>
                  <% if (order.status !== 'cancelled' && order.status !== 'delivered') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST" onsubmit="return confirm('Cancel this order?')">
                    <input type="hidden" name="status" value="cancelled">
                    <button type="submit" class="h-8 w-8 rounded-lg inline-flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition" title="Cancel">
                      <i class="fas fa-times text-xs"></i>
                    </button>
                  </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script>
function showTab(tab) {
  document.getElementById('panel-products').classList.toggle('hidden', tab !== 'products');
  document.getElementById('panel-orders').classList.toggle('hidden', tab !== 'orders');
  const active = 'px-5 py-2.5 rounded-lg text-sm font-semibold bg-white shadow-sm text-gray-900 transition';
  const inactive = 'px-5 py-2.5 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-700 transition';
  document.getElementById('tab-products').className = tab === 'products' ? active : inactive;
  document.getElementById('tab-orders').className = tab === 'orders' ? active : inactive;
}
</script>

<%- include('partials/footer') %>
