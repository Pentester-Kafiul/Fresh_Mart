<%- include('partials/navbar', { user, cartCount }) %>

<!-- Hero Section -->
<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-emerald-800 hero-pattern">
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute top-1/2 -left-20 w-64 h-64 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/3 w-80 h-80 rounded-full bg-emerald-400/10 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fadeInUp">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-sm font-medium text-white/90 backdrop-blur-sm border border-white/10 mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-300 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-300"></span>
          </span>
          Free delivery on orders over $50
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          Fresh Groceries
          <span class="block mt-2 text-brand-200">Delivered to Your Door</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg text-white/75 leading-relaxed">
          Shop the freshest fruits, vegetables, dairy, and more from local farms. Quality products at great prices, delivered right when you need them.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/shop" class="inline-flex items-center gap-2.5 rounded-xl btn-accent text-white font-semibold px-7 py-3.5 shadow-lg shadow-accent-500/30 text-sm">
            <i class="fas fa-shopping-bag"></i> Shop Now
          </a>
          <a href="/shop" class="inline-flex items-center gap-2.5 rounded-xl border border-white/25 text-white hover:bg-white/10 px-7 py-3.5 transition text-sm font-medium backdrop-blur-sm">
            <i class="fas fa-th-large"></i> Browse Categories
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="mt-10 flex flex-wrap items-center gap-6 text-white/60 text-sm">
          <div class="flex items-center gap-2">
            <i class="fas fa-truck text-brand-300"></i>
            <span>Same Day Delivery</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fas fa-leaf text-brand-300"></i>
            <span>100% Fresh</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fas fa-shield-halved text-brand-300"></i>
            <span>Secure Payment</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hidden lg:flex justify-center animate-fadeInUp delay-200">
        <div class="relative w-full max-w-md">
          <div class="absolute inset-0 bg-white/10 rounded-3xl blur-2xl"></div>
          <div class="relative grid grid-cols-3 gap-3">
            <div class="space-y-3 pt-8">
              <div class="rounded-2xl bg-gradient-to-br from-amber-200 via-amber-300 to-yellow-200 aspect-square flex items-center justify-center text-5xl shadow-lg">🍌</div>
              <div class="rounded-2xl bg-gradient-to-br from-red-200 via-rose-300 to-pink-200 aspect-square flex items-center justify-center text-5xl shadow-lg">🍎</div>
            </div>
            <div class="space-y-3">
              <div class="rounded-2xl bg-gradient-to-br from-green-200 via-emerald-300 to-teal-200 aspect-square flex items-center justify-center text-5xl shadow-lg">🥑</div>
              <div class="rounded-2xl bg-gradient-to-br from-sky-200 via-blue-300 to-indigo-200 aspect-square flex items-center justify-center text-5xl shadow-lg animate-float">🥛</div>
            </div>
            <div class="space-y-3 pt-8">
              <div class="rounded-2xl bg-gradient-to-br from-orange-200 via-amber-300 to-yellow-200 aspect-square flex items-center justify-center text-5xl shadow-lg">🍞</div>
              <div class="rounded-2xl bg-gradient-to-br from-purple-200 via-violet-300 to-fuchsia-200 aspect-square flex items-center justify-center text-5xl shadow-lg">🍇</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Categories -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="text-center mb-10">
    <span class="inline-block text-sm font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-3">Categories</span>
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Shop by Category</h2>
    <p class="mt-3 text-gray-500 max-w-md mx-auto">Browse our wide selection of grocery categories for everything you need</p>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
    <% categories.forEach((cat, i) => { %>
      <a href="/search?category=<%= cat.id %>" class="category-card group rounded-2xl bg-white border border-gray-100 p-5 sm:p-6 text-center overflow-hidden relative animate-fadeInUp" style="animation-delay:<%= i * 0.05 %>s">
        <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br <%= getCategoryGradient(cat.name) %> opacity-5 rounded-full -translate-y-8 translate-x-8"></div>
        <div class="mx-auto mb-3 h-16 w-16 rounded-2xl bg-gradient-to-br <%= getCategoryGradient(cat.name) %> flex items-center justify-center text-3xl shadow-lg shadow-black/5 group-hover:scale-110 transition-transform duration-300">
          <%= getCategoryEmoji(cat.name) %>
        </div>
        <h3 class="font-semibold text-gray-900 group-hover:text-brand-700 transition text-sm sm:text-base"><%= cat.name %></h3>
        <p class="text-xs text-gray-400 mt-1"><%= cat.product_count || 0 %> items</p>
      </a>
    <% }); %>
  </div>
</section>

<!-- Featured Products -->
<section class="bg-white py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="inline-block text-sm font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-3">Featured</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Popular Products</h2>
        <p class="mt-2 text-gray-500">Hand-picked favorites from our store</p>
      </div>
      <a href="/shop" class="hidden sm:inline-flex items-center gap-2 rounded-xl border-2 border-brand-200 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50 hover:border-brand-300 transition">
        View All <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
      <% products.forEach((p, i) => { %>
        <div class="product-card rounded-2xl bg-white border border-gray-100 overflow-hidden group animate-fadeInUp" style="animation-delay:<%= i * 0.05 %>s">
          <a href="/product/<%= p.id %>">
            <div class="aspect-square bg-gradient-to-br <%= getCategoryGradient(p.category_name) %> flex items-center justify-center relative overflow-hidden">
              <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"><% } else { %><span class="text-6xl sm:text-7xl group-hover:scale-110 transition-transform duration-500 drop-shadow-lg"><%= getProductEmoji(p.name) %></span><% } %>
              <% if (p.featured) { %>
                <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-xs font-semibold text-amber-700 px-2 py-1 rounded-lg shadow-sm">
                  <i class="fas fa-star text-amber-500 mr-0.5"></i> Featured
                </span>
              <% } %>
              <% if (p.stock <= 5 && p.stock > 0) { %>
                <span class="absolute top-3 right-3 bg-red-500/90 backdrop-blur-sm text-xs font-semibold text-white px-2 py-1 rounded-lg shadow-sm">
                  Only <%= p.stock %> left
                </span>
              <% } %>
            </div>
          </a>
          <div class="p-4">
            <p class="text-[11px] text-brand-600 font-semibold uppercase tracking-wider mb-1"><%= p.category_name %></p>
            <a href="/product/<%= p.id %>">
              <h3 class="font-semibold text-gray-900 line-clamp-2 hover:text-brand-700 transition text-sm sm:text-base leading-snug"><%= p.name %></h3>
            </a>
            <div class="mt-2.5 flex items-baseline gap-2">
              <span class="text-lg font-bold text-gray-900">$<%= parseFloat(p.price).toFixed(2) %></span>
              <span class="text-xs text-gray-400 font-medium">/ <%= p.unit %></span>
            </div>
            <% if (p.stock > 0) { %>
              <form action="/cart/add/<%= p.id %>" method="POST" class="mt-3">
                <button type="submit" class="w-full rounded-xl btn-primary text-white text-sm font-semibold py-2.5 flex items-center justify-center gap-1.5">
                  <i class="fas fa-cart-plus text-xs"></i> Add to Cart
                </button>
              </form>
            <% } else { %>
              <div class="mt-3 text-center py-2.5 rounded-xl bg-gray-100 text-sm font-semibold text-gray-400">Out of Stock</div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="mt-10 text-center sm:hidden">
      <a href="/shop" class="inline-flex items-center gap-2 rounded-xl border-2 border-brand-200 px-6 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50 transition">
        View All Products <i class="fas fa-arrow-right text-xs"></i>
      </a>
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="text-center mb-12">
    <span class="inline-block text-sm font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-3">Why Us</span>
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Why Choose FreshMart?</h2>
    <p class="mt-3 text-gray-500 max-w-md mx-auto">We're committed to bringing you the best grocery experience</p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="rounded-2xl bg-white border border-gray-100 p-7 text-center hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-300 group">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 text-white shadow-lg shadow-brand-500/20 group-hover:scale-110 transition-transform">
        <i class="fas fa-truck text-xl"></i>
      </div>
      <h3 class="font-bold text-gray-900">Free Delivery</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Free delivery on orders over $50. Fast and reliable service to your door.</p>
    </div>
    <div class="rounded-2xl bg-white border border-gray-100 p-7 text-center hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 group">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 text-white shadow-lg shadow-emerald-500/20 group-hover:scale-110 transition-transform">
        <i class="fas fa-leaf text-xl"></i>
      </div>
      <h3 class="font-bold text-gray-900">Always Fresh</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">We source the freshest products from local farms and trusted suppliers.</p>
    </div>
    <div class="rounded-2xl bg-white border border-gray-100 p-7 text-center hover:shadow-xl hover:shadow-amber-500/5 transition-all duration-300 group">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-600 text-white shadow-lg shadow-amber-500/20 group-hover:scale-110 transition-transform">
        <i class="fas fa-clock text-xl"></i>
      </div>
      <h3 class="font-bold text-gray-900">Same Day Delivery</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Order before 2 PM and get your groceries delivered the very same day.</p>
    </div>
    <div class="rounded-2xl bg-white border border-gray-100 p-7 text-center hover:shadow-xl hover:shadow-blue-500/5 transition-all duration-300 group">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 to-indigo-600 text-white shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
        <i class="fas fa-star text-xl"></i>
      </div>
      <h3 class="font-bold text-gray-900">Best Quality</h3>
      <p class="mt-2 text-sm text-gray-500 leading-relaxed">Every product is quality checked to ensure you get only the very best.</p>
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
  <div class="rounded-3xl bg-gradient-to-r from-brand-600 via-brand-700 to-emerald-700 p-8 sm:p-12 text-center relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-10 -right-10 w-60 h-60 rounded-full bg-white/5"></div>
      <div class="absolute bottom-0 left-1/4 w-40 h-40 rounded-full bg-white/5"></div>
    </div>
    <div class="relative">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Ready to start shopping?</h2>
      <p class="mt-3 text-white/70 max-w-lg mx-auto">Join thousands of happy customers who trust FreshMart for their daily groceries.</p>
      <a href="/shop" class="inline-flex items-center gap-2.5 mt-8 rounded-xl btn-accent text-white font-semibold px-8 py-3.5 shadow-lg shadow-accent-500/30 text-sm">
        <i class="fas fa-shopping-bag"></i> Start Shopping Now
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
