<%- include('partials/navbar', { cartCount }) %>

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <a href="/cart" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-brand-600 mb-6 font-medium transition">
    <i class="fas fa-arrow-left text-xs"></i> Back to Cart
  </a>
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Checkout</h1>

  <% if (typeof user === 'undefined' || !user) { %>
  <div class="mb-6 rounded-xl bg-blue-50 border border-blue-100 p-4 text-sm text-blue-700 flex items-center gap-3">
    <i class="fas fa-info-circle text-blue-400"></i>
    <span>Shopping as guest. <a href="/login" class="font-semibold underline hover:text-blue-800">Sign in</a> to track your orders.</span>
  </div>
  <% } %>

  <form action="/checkout" method="POST" id="checkout-form">
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <!-- Delivery Info -->
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 mb-5 flex items-center gap-2">
            <div class="h-8 w-8 rounded-lg bg-brand-50 flex items-center justify-center">
              <i class="fas fa-truck text-brand-600 text-sm"></i>
            </div>
            Delivery Information
          </h2>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name <span class="text-red-400">*</span></label>
              <input type="text" name="customerName" value="<%= (typeof user !== 'undefined' && user) ? user.name : '' %>" required placeholder="John Doe" class="input-field w-full h-11 rounded-xl border border-gray-200 px-4 text-sm outline-none bg-gray-50/50">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
              <input type="email" name="email" value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>" placeholder="you@email.com" class="input-field w-full h-11 rounded-xl border border-gray-200 px-4 text-sm outline-none bg-gray-50/50">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Phone</label>
              <input type="tel" name="phone" placeholder="+1 (555) 123-4567" class="input-field w-full h-11 rounded-xl border border-gray-200 px-4 text-sm outline-none bg-gray-50/50">
            </div>
            <div class="sm:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Delivery Address</label>
              <input type="text" name="address" placeholder="123 Main Street, City, State" class="input-field w-full h-11 rounded-xl border border-gray-200 px-4 text-sm outline-none bg-gray-50/50">
            </div>
          </div>
        </div>

        <!-- Payment Method: manual bKash / Nagad -->
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-2">
            <div class="h-8 w-8 rounded-lg bg-pink-50 flex items-center justify-center">
              <i class="fas fa-wallet text-pink-600 text-sm"></i>
            </div>
            Payment Method
          </h2>
          <p class="text-sm text-gray-500 mb-5">Send the payment using your bKash or Nagad app, then enter the transaction ID. Your order will remain unverified until the admin checks the transaction.</p>

          <div class="grid sm:grid-cols-2 gap-3 mb-5">
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer hover:border-pink-300">
              <input type="radio" name="paymentMethod" value="bkash" required class="h-4 w-4 text-pink-600" checked>
              <span class="font-semibold text-gray-800">bKash</span>
            </label>
            <label class="flex items-center gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer hover:border-orange-300">
              <input type="radio" name="paymentMethod" value="nagad" required class="h-4 w-4 text-orange-600">
              <span class="font-semibold text-gray-800">Nagad</span>
            </label>
          </div>

          <div id="bkash-instructions" class="rounded-xl bg-pink-50 border border-pink-100 p-4 mb-4 text-sm text-pink-900">
            <p class="font-bold mb-1">Send using bKash</p>
            <% if (bkashNumber) { %>
              <p>Send the payment to: <strong><%= bkashNumber %></strong></p>
            <% } else { %>
              <p>The store owner has not configured a bKash number yet. Add <code>BKASH_NUMBER</code> to your <code>.env</code> file before accepting orders.</p>
            <% } %>
            <p class="mt-1">Use the amount shown in the order summary. Keep your transaction ID.</p>
          </div>
          <div id="nagad-instructions" class="hidden rounded-xl bg-orange-50 border border-orange-100 p-4 mb-4 text-sm text-orange-900">
            <p class="font-bold mb-1">Send using Nagad</p>
            <% if (nagadNumber) { %>
              <p>Send the payment to: <strong><%= nagadNumber %></strong></p>
            <% } else { %>
              <p>The store owner has not configured a Nagad number yet. Add <code>NAGAD_NUMBER</code> to your <code>.env</code> file before accepting orders.</p>
            <% } %>
            <p class="mt-1">Use the amount shown in the order summary. Keep your transaction ID.</p>
          </div>

          <label for="transactionId" class="block text-sm font-medium text-gray-700 mb-1.5">Transaction ID <span class="text-red-500">*</span></label>
          <input type="text" id="transactionId" name="transactionId" required maxlength="100" autocomplete="off" placeholder="Enter the transaction ID from your payment app" class="input-field w-full h-11 rounded-xl border border-gray-200 px-4 text-sm outline-none bg-gray-50/50">
          <p class="mt-2 text-xs text-gray-500">Submitting a transaction ID does not automatically confirm payment. The admin must verify the payment in the payment app.</p>
        </div>

        <!-- Order Items Review -->
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 mb-5 flex items-center gap-2">
            <div class="h-8 w-8 rounded-lg bg-brand-50 flex items-center justify-center">
              <i class="fas fa-bag-shopping text-brand-600 text-sm"></i>
            </div>
            Order Items (<%= cart.length %>)
          </h2>
          <div class="space-y-3">
            <% cart.forEach(item => { %>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50">
              <div class="h-11 w-11 rounded-lg bg-gradient-to-br from-emerald-100 to-teal-100 flex items-center justify-center flex-shrink-0 text-xl">
                <%= getProductEmoji(item.name) %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate"><%= item.name %></p>
                <p class="text-xs text-gray-400">$<%= item.price.toFixed(2) %> x <%= item.quantity %></p>
              </div>
              <span class="font-bold text-gray-900 text-sm">$<%= (item.price * item.quantity).toFixed(2) %></span>
            </div>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Order Summary Sidebar -->
      <div>
        <div class="sticky top-24 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 mb-5">Summary</h2>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-500">Subtotal</span>
              <span class="font-semibold text-gray-900">$<%= subtotal.toFixed(2) %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-500">Delivery</span>
              <span class="<%= delivery === 0 ? 'text-brand-600 font-bold' : 'font-semibold text-gray-900' %>">
                <%= delivery === 0 ? 'FREE' : '$' + delivery.toFixed(2) %>
              </span>
            </div>
            <div class="border-t border-gray-100 pt-4 flex justify-between">
              <span class="font-bold text-gray-900">Total</span>
              <span class="font-extrabold text-brand-700 text-xl">$<%= total.toFixed(2) %></span>
            </div>
          </div>
          <button type="submit" class="mt-6 w-full rounded-xl btn-primary text-white font-bold h-12 shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2">
            <i class="fas fa-lock text-sm"></i> Place Order
          </button>
          <p class="mt-3 text-center text-xs text-gray-400">
            <% if (subtotal > 50) { %><i class="fas fa-truck mr-1"></i>Free delivery applied!<% } else { %><i class="fas fa-info-circle mr-1"></i>Add $<%= (50 - subtotal).toFixed(2) %> more for free delivery<% } %>
          </p>
        </div>
      </div>
    </div>
  </form>
</section>

<script>
  (function () {
    const radios = document.querySelectorAll('input[name="paymentMethod"]');
    const bkash = document.getElementById('bkash-instructions');
    const nagad = document.getElementById('nagad-instructions');
    function updatePaymentInstructions() {
      const selected = document.querySelector('input[name="paymentMethod"]:checked');
      const method = selected ? selected.value : 'bkash';
      bkash.classList.toggle('hidden', method !== 'bkash');
      nagad.classList.toggle('hidden', method !== 'nagad');
    }
    radios.forEach(radio => radio.addEventListener('change', updatePaymentInstructions));
    updatePaymentInstructions();
  })();
</script>

<%- include('partials/footer') %>
