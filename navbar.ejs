<%- include('head', {}) %>

<!-- Flash Messages -->
<% if (flash && flash.length > 0) { %>
<div id="toast-container" class="fixed top-20 right-4 z-[100] space-y-2 max-w-sm">
  <% flash.forEach((f, i) => { %>
    <div class="toast-enter rounded-xl shadow-lg shadow-black/5 border p-4 flex items-start gap-3 text-sm
      <% if (f.type === 'success') { %>bg-white border-green-200 text-green-800<% }
      else if (f.type === 'error') { %>bg-white border-red-200 text-red-800<% }
      else if (f.type === 'warning') { %>bg-white border-amber-200 text-amber-800<% }
      else { %>bg-white border-blue-200 text-blue-800<% } %>"
      id="toast-<%= i %>">
      <div class="flex h-6 w-6 items-center justify-center rounded-full flex-shrink-0 mt-0.5
        <% if (f.type === 'success') { %>bg-green-100<% }
        else if (f.type === 'error') { %>bg-red-100<% }
        else if (f.type === 'warning') { %>bg-amber-100<% }
        else { %>bg-blue-100<% } %>">
        <i class="fas text-xs
          <% if (f.type === 'success') { %>fa-check text-green-600<% }
          else if (f.type === 'error') { %>fa-xmark text-red-600<% }
          else if (f.type === 'warning') { %>fa-exclamation text-amber-600<% }
          else { %>fa-info text-blue-600<% } %>"></i>
      </div>
      <span class="flex-1 leading-relaxed"><%= f.message %></span>
      <button onclick="dismissToast(<%= i %>)" class="opacity-40 hover:opacity-100 ml-1 mt-0.5"><i class="fas fa-xmark text-xs"></i></button>
    </div>
  <% }); %>
</div>
<script>
  function dismissToast(i) {
    const el = document.getElementById('toast-' + i);
    if (el) { el.classList.remove('toast-enter'); el.classList.add('toast-exit'); setTimeout(() => el.remove(), 300); }
  }
  setTimeout(() => {
    document.querySelectorAll('[id^="toast-"]').forEach((el, i) => {
      setTimeout(() => dismissToast(el.id.split('-')[1]), i * 100);
    });
  }, 5000);
</script>
<% } %>

<!-- Navbar -->
<nav class="sticky top-0 z-50 glass border-b border-white/20 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition shrink-0 group">
        <div class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-lg shadow-brand-500/25">
          <i class="fas fa-leaf text-lg"></i>
        </div>
        <span class="text-xl font-bold tracking-tight hidden sm:block">
          <span class="text-brand-700">Fresh</span><span class="text-gray-800">Mart</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/" class="px-3.5 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition">
          <i class="fas fa-home mr-1.5 text-xs"></i>Home
        </a>
        <a href="/shop" class="px-3.5 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition">
          <i class="fas fa-store mr-1.5 text-xs"></i>Shop
        </a>
        <a href="/orders" class="px-3.5 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition">
          <i class="fas fa-clipboard-list mr-1.5 text-xs"></i>Orders
        </a>

        <!-- Search -->
        <form action="/search" method="GET" class="ml-3">
          <div class="relative flex items-center">
            <i class="fas fa-search absolute left-3 text-gray-400 text-xs pointer-events-none"></i>
            <input type="text" name="q" placeholder="Search products..." class="input-field h-9 w-56 rounded-xl border border-gray-200 bg-white/70 pl-9 pr-3 text-sm outline-none">
          </div>
        </form>

        <!-- Cart -->
        <a href="/cart" class="ml-1 relative flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-700 hover:bg-brand-50 transition">
          <i class="fas fa-shopping-bag text-sm"></i>
          <span class="hidden lg:inline">Cart</span>
          <% if (cartCount > 0) { %>
            <span class="absolute -top-0.5 -right-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-gradient-to-r from-accent-500 to-accent-600 text-[10px] font-bold text-white shadow-sm">
              <%= cartCount > 99 ? '99+' : cartCount %>
            </span>
          <% } %>
        </a>

        <!-- User Menu -->
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="relative group ml-1">
            <button class="flex items-center gap-2 h-9 px-2 rounded-xl hover:bg-gray-100 transition">
              <div class="h-8 w-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center text-xs font-bold shadow-sm">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
              <span class="text-sm font-medium text-gray-700 max-w-[100px] truncate hidden lg:block"><%= user.name %></span>
              <i class="fas fa-chevron-down text-[10px] text-gray-400 group-hover:text-gray-600 transition"></i>
            </button>
            <div class="absolute right-0 top-full mt-1.5 w-56 bg-white rounded-2xl shadow-xl shadow-black/10 border border-gray-100 py-2 hidden group-hover:block z-50 animate-fadeIn">
              <div class="px-4 py-3 border-b border-gray-50">
                <p class="text-sm font-semibold text-gray-900"><%= user.name %></p>
                <p class="text-xs text-gray-500 mt-0.5"><%= user.email %></p>
                <% if (user.role === 'admin') { %>
                  <span class="inline-flex items-center gap-1 mt-1.5 text-[10px] font-semibold bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full border border-amber-100">
                    <i class="fas fa-shield-halved text-[8px]"></i> Administrator
                  </span>
                <% } %>
              </div>
              <% if (user.role === 'admin') { %>
                <a href="/admin" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition">
                  <i class="fas fa-gauge-high w-4 text-gray-400"></i>Admin Dashboard
                </a>
              <% } %>
              <a href="/orders" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition">
                <i class="fas fa-clipboard-list w-4 text-gray-400"></i>My Orders
              </a>
              <a href="/cart" class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition">
                <i class="fas fa-shopping-bag w-4 text-gray-400"></i>Shopping Cart
              </a>
              <div class="border-t border-gray-50 mt-1 pt-1">
                <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-500 hover:bg-red-50 transition">
                  <i class="fas fa-right-from-bracket w-4"></i>Sign Out
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <a href="/login" class="ml-2 inline-flex items-center gap-1.5 h-9 px-5 rounded-xl btn-primary text-white text-sm font-semibold">
            <i class="fas fa-right-to-bracket text-xs"></i><span class="hidden xl:inline"> Sign In</span>
          </a>
        <% } %>
      </div>

      <!-- Mobile Buttons -->
      <div class="flex items-center gap-2 md:hidden">
        <form action="/search" method="GET" class="hidden" id="mobile-search-form">
          <input type="text" name="q" placeholder="Search..." class="input-field h-9 w-full rounded-xl border border-gray-200 bg-white px-3 text-sm outline-none">
        </form>
        <button onclick="document.getElementById('mobile-search-form').classList.toggle('hidden');document.getElementById('mobile-search-form').querySelector('input').focus()" class="p-2 text-gray-500 hover:text-brand-700 transition">
          <i class="fas fa-search text-lg"></i>
        </button>
        <a href="/cart" class="relative p-2 text-gray-500 hover:text-brand-700 transition">
          <i class="fas fa-shopping-bag text-lg"></i>
          <% if (cartCount > 0) { %>
            <span class="absolute -top-0.5 -right-0.5 flex h-4.5 w-4.5 items-center justify-center rounded-full bg-accent-500 text-[9px] font-bold text-white">
              <%= cartCount %>
            </span>
          <% } %>
        </a>
        <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden');document.getElementById('mobile-overlay').classList.toggle('hidden')" class="p-2 text-gray-500 hover:text-brand-700 transition">
          <i class="fas fa-bars text-lg"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-overlay" class="hidden fixed inset-0 bg-black/20 z-40 md:hidden" onclick="document.getElementById('mobile-menu').classList.add('hidden');this.classList.add('hidden')"></div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden fixed top-0 right-0 h-full w-72 bg-white shadow-2xl z-50 md:hidden animate-slideIn">
    <div class="flex items-center justify-between p-4 border-b border-gray-100">
      <span class="text-lg font-bold text-brand-700">Menu</span>
      <button onclick="document.getElementById('mobile-menu').classList.add('hidden');document.getElementById('mobile-overlay').classList.add('hidden')" class="p-2 text-gray-400 hover:text-gray-600"><i class="fas fa-xmark text-lg"></i></button>
    </div>
    <div class="p-4 space-y-1">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 mb-3">
          <div class="h-10 w-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center font-bold"><%= user.name.charAt(0).toUpperCase() %></div>
          <div>
            <p class="text-sm font-semibold text-gray-900"><%= user.name %></p>
            <p class="text-xs text-gray-500"><%= user.email %></p>
          </div>
        </div>
      <% } %>
      <a href="/" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition font-medium">
        <i class="fas fa-home w-5 text-center text-gray-400"></i>Home
      </a>
      <a href="/shop" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition font-medium">
        <i class="fas fa-store w-5 text-center text-gray-400"></i>Shop All
      </a>
      <a href="/cart" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition font-medium">
        <i class="fas fa-shopping-bag w-5 text-center text-gray-400"></i>Cart
        <% if (cartCount > 0) { %><span class="ml-auto bg-accent-500 text-white text-xs font-bold px-2 py-0.5 rounded-full"><%= cartCount %></span><% } %>
      </a>
      <a href="/orders" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition font-medium">
        <i class="fas fa-clipboard-list w-5 text-center text-gray-400"></i>My Orders
      </a>
      <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <a href="/admin" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition font-medium">
          <i class="fas fa-shield-halved w-5 text-center text-gray-400"></i>Admin
        </a>
      <% } %>
      <div class="border-t border-gray-100 pt-3 mt-3">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/logout" class="flex items-center gap-3 px-3 py-3 rounded-xl text-red-500 hover:bg-red-50 transition font-medium">
            <i class="fas fa-right-from-bracket w-5 text-center"></i>Sign Out
          </a>
        <% } else { %>
          <a href="/login" onclick="closeMobile()" class="flex items-center gap-3 px-3 py-3 rounded-xl text-brand-600 hover:bg-brand-50 transition font-semibold">
            <i class="fas fa-right-to-bracket w-5 text-center"></i>Sign In
          </a>
        <% } %>
      </div>
    </div>
  </div>
  <script>
    function closeMobile() {
      document.getElementById('mobile-menu').classList.add('hidden');
      document.getElementById('mobile-overlay').classList.add('hidden');
    }
  </script>
</nav>

<main class="min-h-screen">
