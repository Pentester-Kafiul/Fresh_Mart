<%- include('partials/navbar', { user, cartCount }) %>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm text-gray-400 mb-6">
    <a href="/" class="hover:text-brand-600 transition">Home</a>
    <i class="fas fa-chevron-right text-[10px]"></i>
    <a href="/shop" class="hover:text-brand-600 transition">Shop</a>
    <i class="fas fa-chevron-right text-[10px]"></i>
    <span class="text-gray-700 font-medium"><%= product.name %></span>
  </div>

  <div class="grid md:grid-cols-2 gap-8 lg:gap-14">
    <!-- Product Image -->
    <div class="animate-fadeIn">
      <div class="aspect-square rounded-3xl bg-gradient-to-br <%= getCategoryGradient(product.category_name) %> flex items-center justify-center relative overflow-hidden shadow-xl shadow-black/5">
        <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>" class="absolute inset-0 w-full h-full object-cover"><% } else { %><span class="text-8xl sm:text-9xl drop-shadow-2xl"><%= getProductEmoji(product.name) %></span><% } %>
        <% if (product.featured) { %>
          <span class="absolute top-5 left-5 bg-white/90 backdrop-blur-sm text-sm font-semibold text-amber-700 px-3 py-1.5 rounded-xl shadow-sm">
            <i class="fas fa-star text-amber-500 mr-1"></i> Featured
          </span>
        <% } %>
      </div>
    </div>

    <!-- Product Details -->
    <div class="animate-fadeInUp">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1.5 rounded-full border border-brand-100">
        <i class="fas fa-tag text-[10px]"></i> <%= product.category_name %>
      </span>

      <h1 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900 leading-tight"><%= product.name %></h1>

      <!-- Price -->
      <div class="mt-5 flex items-baseline gap-3">
        <span class="text-3xl font-extrabold text-gray-900">$<%= parseFloat(product.price).toFixed(2) %></span>
        <span class="text-gray-400 font-medium">per <%= product.unit %></span>
      </div>

      <!-- Stock Status -->
      <div class="mt-4 flex items-center gap-3">
        <% if (product.stock > 10) { %>
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-100">
            <i class="fas fa-circle-check text-xs"></i> In Stock (<%= product.stock %> available)
          </span>
        <% } else if (product.stock > 0) { %>
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 bg-amber-50 px-3 py-1.5 rounded-full border border-amber-100">
            <i class="fas fa-exclamation-triangle text-xs"></i> Only <%= product.stock %> left!
          </span>
        <% } else { %>
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-red-500 bg-red-50 px-3 py-1.5 rounded-full border border-red-100">
            <i class="fas fa-circle-xmark text-xs"></i> Out of Stock
          </span>
        <% } %>
      </div>

      <!-- Description -->
      <div class="mt-8 border-t border-gray-100 pt-6">
        <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-3">Description</h2>
        <p class="text-gray-600 leading-relaxed"><%= product.description || 'No description available for this product.' %></p>
      </div>

      <!-- Unit Info -->
      <div class="mt-6 grid grid-cols-3 gap-3">
        <div class="rounded-xl bg-gray-50 p-3 text-center">
          <i class="fas fa-truck text-brand-500 text-sm mb-1"></i>
          <p class="text-[11px] text-gray-500 font-medium">Free Delivery</p>
        </div>
        <div class="rounded-xl bg-gray-50 p-3 text-center">
          <i class="fas fa-rotate-left text-brand-500 text-sm mb-1"></i>
          <p class="text-[11px] text-gray-500 font-medium">Easy Returns</p>
        </div>
        <div class="rounded-xl bg-gray-50 p-3 text-center">
          <i class="fas fa-shield-halved text-brand-500 text-sm mb-1"></i>
          <p class="text-[11px] text-gray-500 font-medium">Secure Pay</p>
        </div>
      </div>

      <!-- Add to Cart -->
      <% if (product.stock > 0) { %>
        <div class="mt-8">
          <form action="/cart/add/<%= product.id %>" method="POST">
            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-xl btn-primary text-white font-bold px-10 py-4 text-sm shadow-lg shadow-brand-500/25">
              <i class="fas fa-cart-plus"></i> Add to Cart
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Related Products -->
  <% if (related.length > 0) { %>
    <section class="mt-20 border-t border-gray-100 pt-12">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Related Products</h2>
          <p class="text-gray-500 mt-1">You might also like these</p>
        </div>
        <a href="/search?category=<%= product.category_id %>" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700 transition">
          View All <i class="fas fa-arrow-right text-xs"></i>
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5">
        <% related.forEach(p => { %>
          <div class="product-card rounded-2xl bg-white border border-gray-100 overflow-hidden group">
            <a href="/product/<%= p.id %>">
              <div class="aspect-square bg-gradient-to-br <%= getCategoryGradient(product.category_name) %> flex items-center justify-center overflow-hidden">
                <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"><% } else { %><span class="text-5xl sm:text-6xl group-hover:scale-110 transition-transform duration-500 drop-shadow-lg"><%= getProductEmoji(p.name) %></span><% } %>
              </div>
            </a>
            <div class="p-3 sm:p-4">
              <a href="/product/<%= p.id %>">
                <h3 class="font-semibold text-gray-900 line-clamp-2 hover:text-brand-700 transition text-sm leading-snug"><%= p.name %></h3>
              </a>
              <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-base font-bold text-gray-900">$<%= parseFloat(p.price).toFixed(2) %></span>
                <span class="text-[11px] text-gray-400">/ <%= p.unit %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>
</section>

<%- include('partials/footer') %>
